# =====================================================================
# PYTEST CONFIGURATION FILE
# Project: WSJ Customer Center Automation Tests
# =====================================================================

[pytest]

# ---------------------------------------------------------------------
# 1️⃣ MARKERS: Logical Test Suite Definitions
# ---------------------------------------------------------------------
markers =
    ui: Marks UI-related test cases (Playwright-based)
    smoke: Marks Smoke tests - critical path verification
    sanity: Marks Sanity tests - basic validation after deployment
    regression: Marks Regression tests - complete coverage suite
    api: Marks API tests (if added later)
    performance: Marks Performance or load-related checks
    database: Marks tests interacting with DB layer
    critical: Marks high-priority tests to be run before releases

# ---------------------------------------------------------------------
# 2️⃣ DEFAULT COMMAND-LINE OPTIONS
# ---------------------------------------------------------------------
#   -v                     → Verbose test output
#   -s                     → Show print/log statements in real-time
#   --color=yes            → Always display console colors
#   --no-header            → Hide Python/platform/plugin info from pytest output
#   --no-summary           → Hide pytest’s summary footer (your logger handles this)
#   --html / --self-contained-html → Generate self-contained HTML report
# ---------------------------------------------------------------------
addopts = -q -v -s --mybrowser=chrome --headed --color=yes --no-header --no-summary --html=reports/PytestReport.html --self-contained-html --alluredir=reports/allure-results

#pytest -s --mybrowser=edge --html=reports/PytestReport.html --self-contained-html --alluredir=reports/allure-results -v
# ---------------------------------------------------------------------
# 3️⃣ TEST DISCOVERY RULES
# ---------------------------------------------------------------------
testpaths = tests
python_files = test_*.py
python_classes = Test*
python_functions = test_*

# ---------------------------------------------------------------------
# 4️⃣ LOGGING CONFIGURATION
# ---------------------------------------------------------------------
# Commented out because custom reporter handles colored console logs
# Avoid pytest’s built-in log_cli to prevent duplicate lines
# ---------------------------------------------------------------------
;log_cli = true
;log_cli_level = INFO
;log_cli_format = %(asctime)s - %(levelname)-8s - %(message)s
;log_cli_date_format = %Y-%m-%d %H:%M:%S
;log_cli_skip_content = true

# ---------------------------------------------------------------------
# 5️⃣ WARNING FILTERS
# ---------------------------------------------------------------------
filterwarnings =
    ignore::DeprecationWarning
    ignore::UserWarning
    ignore::pytest.PytestUnknownMarkWarning

# ---------------------------------------------------------------------
# 6️⃣ ENVIRONMENT VARIABLES (Optional)
# ---------------------------------------------------------------------
env =
    ENV=test
    #BASE_URL=https://customercenter-newlz.s.dev.wsj.com
    BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php/auth/login
